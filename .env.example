# Copy this file to .env and fill in values:
#   copy .env.example .env

# Django
SECRET_KEY=change-me-generate-a-strong-secret-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose entrypoint: True = runserver with reload; False = gunicorn
DEVELOPMENT=False

# PostgreSQL — credentials must match the db service / your Postgres install
POSTGRES_DB=harmix_db
POSTGRES_USER=harmix_user
POSTGRES_PASSWORD=change-me

# Django DB connection
# Docker Compose: use host name of the db service (see docker-compose.yml)
DB_HOST=db
DB_PORT=5432

# Local development without Docker: set DB_HOST=localhost (Postgres on your machine)

# Celery / Redis async processing
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=3600
